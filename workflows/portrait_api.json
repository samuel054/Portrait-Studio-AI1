{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{IMAGE_REFERENCE}}"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{PROMPT}}",
      "clip": ["10", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE_PROMPT}}",
      "clip": ["10", 1]
    }
  },
  "4": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 28,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": "{{DENOISE}}",
      "model": ["10", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["12", 0]
    }
  },
  "5": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["4", 0],
      "vae": ["10", 2]
    }
  },
  "6": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "portrait_studio",
      "images": ["5", 0]
    }
  },
  "10": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{CHECKPOINT}}"
    }
  },
  "11": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["13", 0],
      "vae": ["10", 2]
    }
  },
  "12": {
    "class_type": "RepeatLatentBatch",
    "inputs": {"samples": ["11", 0], "amount": "{{CANDIDATE_COUNT}}"}
  },
  "13": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {"image": ["1", 0], "upscale_method": "lanczos", "megapixels": 1.0}
  }
}
