# Local service ports
WEB_PORT=3000
API_PORT=8000

# Application
PORTRAIT_ENVIRONMENT=development
PORTRAIT_LOG_LEVEL=INFO
PORTRAIT_MAX_UPLOAD_MB=20
PORTRAIT_MAX_IMAGE_PIXELS=40000000
PORTRAIT_SESSION_TTL_MINUTES=60
PORTRAIT_LIKENESS_THRESHOLD=0.35

# Local persistence
PORTRAIT_WORKFLOW_DB=/data/portrait_workflows.db
PORTRAIT_FEEDBACK_DB=/data/portrait_feedback.db

# ComfyUI is expected to run locally on the host for the MVP.
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_WORKFLOW_PATH=workflows/portrait_api.json
COMFYUI_TIMEOUT_SECONDS=120
