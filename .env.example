# Local service ports
WEB_PORT=3000
API_PORT=8000

# Application
PORTRAIT_APP_NAME=Portrait Studio AI
PORTRAIT_APP_VERSION=0.21.0
PORTRAIT_ENVIRONMENT=development
PORTRAIT_LOG_LEVEL=INFO

# ComfyUI is expected to run locally on the host for the MVP.
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_WORKFLOW_PATH=workflows/portrait_api.json
COMFYUI_TIMEOUT_SECONDS=120

# Workflow engine
PORTRAIT_ENABLE_BACKGROUND_WORKER=true
PORTRAIT_POLL_INTERVAL_SECONDS=2
PORTRAIT_WORKFLOW_MAX_RETRIES=3
PORTRAIT_WORKFLOW_TIMEOUT_SECONDS=900

# Persistent local databases
PORTRAIT_WORKFLOW_DB=/data/portrait_workflows.db
PORTRAIT_CANDIDATE_DB=/data/portrait_candidates.db
PORTRAIT_FEEDBACK_DB=/data/portrait_feedback.db

# Upload, identity, and retention rules
PORTRAIT_MAX_UPLOAD_MB=20
PORTRAIT_MAX_IMAGE_PIXELS=40000000
PORTRAIT_SESSION_TTL_MINUTES=60
PORTRAIT_LIKENESS_THRESHOLD=0.35

# Optional API security. Leave empty for local development.
PORTRAIT_API_KEY=
PORTRAIT_RATE_LIMIT_REQUESTS=120
PORTRAIT_RATE_LIMIT_WINDOW_SECONDS=60
